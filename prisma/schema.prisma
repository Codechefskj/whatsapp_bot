generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== WHATSAPP MESSAGE =====================
enum MessageDirection {
  IN // user -> us
  OUT // us -> user
}

model WhatsAppMessage {
  id        Int              @id @default(autoincrement())
  from      String // IN: the user's number | OUT: our WhatsApp phone number id
  to        String? // OUT: the user's number | IN: empty
  text      String
  direction MessageDirection @default(IN)
  messageId String           @unique
  createdAt DateTime         @default(now())

  @@index([from])
  @@index([to])
}

// ===================== DESIGN APPROVAL =====================
enum DesignStatus {
  PENDING // image + buttons sent, waiting for a click
  APPROVED // user tapped "Approved"
  AWAITING_FEEDBACK // user tapped "Not approved", waiting for their comment
  REJECTED // comment received
}

model Design {
  id          Int          @id @default(autoincrement())
  to          String // user's WhatsApp number (digits only)
  mediaId     String? // WhatsApp media id of the image we sent
  status      DesignStatus @default(PENDING)
  feedback    String? // the user's comment after "Not approved"
  externalRef String? // your own design/job id from the other system
  handoffKey  String?      @unique // Agentic job + revision idempotency key
  createdAt   DateTime     @default(now())
  respondedAt DateTime?

  @@index([to, status])
}

enum IntegrationJobStatus {
  PENDING
  PROCESSING
  RETRY
  COMPLETED
  FAILED
}

model IntegrationJob {
  id          Int                  @id @default(autoincrement())
  kind        String
  dedupeKey   String               @unique
  payload     Json
  status      IntegrationJobStatus @default(PENDING)
  attempts    Int                  @default(0)
  runAfter    DateTime             @default(now())
  lastError   String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([status, runAfter])
}

model ConversationSession {
  id                Int      @id @default(autoincrement())
  phone             String   @unique
  productDraftId    String?
  pendingQuestionId String?
  designJobId       String?
  status            String   @default("COLLECTING")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}